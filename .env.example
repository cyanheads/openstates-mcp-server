# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # stateful | stateless | auto. Set here, not left to the schema default
                                    # (auto, which resolves to stateful). Stateless fits this data API:
                                    # no session store, horizontally scalable. Use stateful when a tool
                                    # asks the caller for input mid-handler (ctx.requestInput) — no tool
                                    # here does. src/index.ts declares the same value via createApp().

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed tool calls' arguments + result (key-name redaction only;
                                             # secrets in free-form values are kept). Reaches stderr, files, and OTLP
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Per-payload cap, UTF-8 bytes

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Opt-in log export (e.g., http://localhost:4318/v1/logs); the base never enables it

# ── Open States ───────────────────────────────────────────────────────
OPENSTATES_API_KEY=                   # Required. API key from open.pluralpolicy.com
# OPENSTATES_API_BASE_URL=https://v3.openstates.org  # API base URL (default: https://v3.openstates.org)
# OPENSTATES_DAILY_REQUEST_BUDGET=250   # Max upstream requests per rolling 24h (default: 250, the
#                                       # free-tier daily cap). Raise it if your key's tier allows more.
# OPENSTATES_REQUEST_TIMEOUT_MS=45000   # Per-attempt upstream deadline (default: 45000, min: 1000).
#                                       # Upstream's own gateway gives up near 60s; lower it to fail
#                                       # sooner, raise it to wait out a slow query.
# OPENSTATES_TOTAL_REQUEST_BUDGET_MS=90000  # Wall-clock ceiling for one call across every retry
#                                       # attempt (default: 90000). Bounds a slow upstream that keeps
#                                       # failing retryably. Must be >= the per-attempt deadline
#                                       # above — startup fails if it is lower.
